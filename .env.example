# Configurar en .env.local (Node.js 20.12 o superior) o en el entorno del servidor.
# Nunca usar prefijo VITE_ para secretos.
OPENAI_API_KEY=
# Modelo con soporte de Structured Outputs en Responses, habilitado en tu cuenta.
OPENAI_MODEL=

# Copias consistentes de SQLite. Por defecto: carpeta respaldos junto a la base.
# Usa una ruta de disco externo o una carpeta sincronizada para una copia fuera del servidor.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=30
# BACKUP_DIR=C:/respaldos-nomina
